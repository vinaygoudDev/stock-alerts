# Get free API key at https://finnhub.io → Sign up → Dashboard → API Key
FINNHUB_API_KEY=your_finnhub_key_here

# Pick any unique topic name — this is your private channel on ntfy.sh
# Install ntfy app on Android, subscribe to this topic, done.
NTFY_TOPIC=your-unique-topic-name-here

# How often to check prices (in seconds). 30s is safe for free tier.
POLL_INTERVAL_SECONDS=30
